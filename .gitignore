# Python runtime artifacts
__pycache__/
*.py[cod]
*$py.class

# Local EMS runtime backups
*.bak
*.bak-*
*.before-*

# Local EMS runtime state / generated data
/src/pi/ems-runtime/data/
/src/pi/ems-runtime/logs/

# Local EMS runtime databases
*.sqlite
*.sqlite3

# Temporary migration/build artifacts
/src/pi/ems-runtime/tmp/
/tmp/

# Local secrets / API credentials
**/account.env
**/.env

# Honeywell runtime-only virtualenv, tokens, cache and generated output
/src/pi/ems-runtime/tools/honeywell/.venv/
/src/pi/ems-runtime/tools/honeywell/cache/
/src/pi/ems-runtime/tools/honeywell/output/

# Retired public GitHub Pages runtime snapshots (private Pi is authoritative).
# Do not reintroduce household telemetry or one-off diagnostics via docs/data/.
/docs/data/history/
/docs/data/temp-*.json
/docs/data/contract-history-v01.json
/docs/data/contract-shadow-validation.json
/docs/data/energy-control-history-v2.json
/docs/data/p1-runtime-validation.json
/docs/data/site-inspection.json
/docs/data/ww-seasonal-validation.json
