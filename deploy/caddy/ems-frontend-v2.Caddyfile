# EMS Frontend V2 private ingress
#
# Canonical deployment intent:
# - serve exactly one website address on the Pi Tailscale interface;
# - no LAN, wildcard, Wi-Fi, Docker, or public website listener;
# - serve the Pi-local V2 build;
# - proxy read-only /web/* requests to the localhost Web Data API.
#
# The same tailnet URL is used at home and away, by browser and SwiftUI app.
# No public ingress, router port-forward, Tailscale Serve, or Tailscale Funnel is permitted.

http://100.127.130.0 {
    bind 100.127.130.0
    root * /var/www/ems-frontend-v2

    # Restrict command writes to encrypted Tailscale transport.
    @tailnet remote_ip 100.64.0.0/10
    handle /web/commands/tesla {
        handle @tailnet {
            rewrite * /commands/tesla
            reverse_proxy 127.0.0.1:3100
        }
        handle {
            respond "Tailscale required for command writes" 403
        }
    }

    handle /web/* {
        reverse_proxy 127.0.0.1:3200
    }

    handle /agent/* {
        reverse_proxy 127.0.0.1:3210
    }

    handle {
        header Cache-Control "no-store"
        file_server
    }

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
    }

}
