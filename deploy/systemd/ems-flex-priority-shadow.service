[Unit]
Description=EMS Flex Priority V0.1 shadow builder
After=ems-heating-preheat-shadow.service ems-ev-deadline-state.service

[Service]
Type=oneshot
User=jeroen
WorkingDirectory=/home/jeroen/ems/repo/homey-energy-manual
ExecStart=/usr/bin/python3 /home/jeroen/ems/repo/homey-energy-manual/services/pi/planner/joint/run_flex_priority_shadow_v0_1.py
TimeoutStartSec=30
Nice=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/jeroen/ems/data
