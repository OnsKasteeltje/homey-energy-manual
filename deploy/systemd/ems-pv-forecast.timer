[Unit]
Description=PARKED LEGACY - standalone EMS PV Forecast

[Timer]
# PARKED LEGACY: production cadence is owned by ems-forecast-chain.timer.
# scripts/deploy_ems_pi.sh explicitly disables and stops this timer.
OnCalendar=*-*-* *:03,18,33,48:00
Persistent=true
Unit=ems-pv-forecast.service

[Install]
WantedBy=timers.target
