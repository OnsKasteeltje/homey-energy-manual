[Unit]
Description=EMS read-only Web Data API
After=network.target

[Service]
Type=simple
User=jeroen
WorkingDirectory=/home/jeroen/ems/runtime/web-data-api
Environment=EMS_WEB_DATA_HOST=127.0.0.1
Environment=EMS_WEB_DATA_PORT=3200
ExecStart=/usr/bin/python3 /home/jeroen/ems/runtime/web-data-api/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# SQLite WAL-mode read-only queries can require creating -wal/-shm in the
# database directory when neither sidecar exists. Only this directory
# is exempted from the namespace-wide read-only mount.
ReadWritePaths=/home/jeroen/ems/data
# Keep both source database files separately read-only inside the API
# namespace. This unit remains a reader (SQLite mode=ro); no schema writes.
ReadOnlyPaths=/home/jeroen/ems/data/ems-history.sqlite
ReadOnlyPaths=-/home/jeroen/ems/data/planner-history.sqlite
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
