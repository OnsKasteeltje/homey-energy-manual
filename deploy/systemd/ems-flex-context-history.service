[Unit]
Description=EMS read-only flex context history archive
After=ems-heating-preheat-progression-shadow.service ems-flex-priority-shadow.service

[Service]
Type=oneshot
User=jeroen
WorkingDirectory=/home/jeroen/ems/runtime/history
ExecStart=/usr/bin/python3 /home/jeroen/ems/runtime/history/archive_flex_context_snapshot.py
TimeoutStartSec=30
Nice=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/jeroen/ems/data
