[Unit]
Description=EMS energy-state website observability publication
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jeroen
WorkingDirectory=/home/jeroen/ems/repo/homey-energy-manual
ExecStart=/usr/bin/python3 /home/jeroen/ems/repo/homey-energy-manual/services/pi/integrations/github/publish_energy_state.py

# OBSERVABILITY ONLY.
# This unit publishes a derived GitHub/website artifact and MUST NOT be used
# as Homey/Pi runtime transport or as an actuator/control path.
