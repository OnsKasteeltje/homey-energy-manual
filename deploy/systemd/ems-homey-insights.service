[Unit]
Description=EMS Homey Insights Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jeroen
ExecStart=/usr/bin/python3 /home/jeroen/ems/runtime/datastore/collect_homey_insights.py
ExecStart=/usr/bin/python3 /home/jeroen/ems/runtime/datastore/collect_boiler_insights.py
ExecStart=/usr/bin/python3 /home/jeroen/ems/runtime/datastore/build_15m_history.py
