[Unit]
Description=EMS Quatt current-state collector (read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jeroen
WorkingDirectory=/home/jeroen/ems/runtime/thermal
ExecStart=/usr/bin/python3 /home/jeroen/ems/runtime/thermal/collect_quatt_current.py
TimeoutStartSec=60
Nice=10
UMask=0077
Environment=PYTHONUNBUFFERED=1
