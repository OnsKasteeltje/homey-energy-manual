[Unit]
Description=Archive Quatt CiC supervisory mode (read-only evidence)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jeroen
WorkingDirectory=/home/jeroen/ems/repo/homey-energy-manual
EnvironmentFile=/etc/default/ems-quatt-cic-mode
ExecStart=/usr/bin/python3 /home/jeroen/ems/repo/homey-energy-manual/services/pi/integrations/quatt/collect_quatt_cic_mode.py
TimeoutStartSec=12
Nice=10
UMask=0077
NoNewPrivileges=true
