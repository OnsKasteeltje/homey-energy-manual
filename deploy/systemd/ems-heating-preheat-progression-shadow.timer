[Unit]
Description=Refresh EMS Heating Preheat V0.4 progression shadow every minute

[Timer]
# Local-only state machine. Deterministic order is V0.3 :00 when due,
# Flex Priority :10, then V0.4 :20. Freshness/ordering guards still fail
# closed if the priority state predates V0.3.
OnCalendar=*-*-* *:*:20
Persistent=true
AccuracySec=1s
Unit=ems-heating-preheat-progression-shadow.service

[Install]
WantedBy=timers.target
