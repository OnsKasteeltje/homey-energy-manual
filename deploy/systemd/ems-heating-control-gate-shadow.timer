[Unit]
Description=Refresh EMS Heating Control Gate V0.5 shadow every minute

[Timer]
# V0.4 progression runs at :20; V0.5 runs deterministically after it at :30
# and has no device writes.
OnCalendar=*-*-* *:*:30
Persistent=true
AccuracySec=1s
Unit=ems-heating-control-gate-shadow.service

[Install]
WantedBy=timers.target
