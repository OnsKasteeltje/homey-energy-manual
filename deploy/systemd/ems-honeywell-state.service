[Unit]
Description=EMS Honeywell state collector (read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jeroen
WorkingDirectory=/home/jeroen/ems/runtime/tools/honeywell
ExecStart=/home/jeroen/ems/runtime/tools/honeywell/.venv/bin/python /home/jeroen/ems/runtime/tools/honeywell/collect_honeywell.py
TimeoutStartSec=60
Nice=10
UMask=0077
Environment=PYTHONUNBUFFERED=1
