[Unit]
Description=Archive EMS flex context every minute

[Timer]
# Run after Heating progression (:20) and V0.5 control-gate SHADOW (:30).
# Reads Pi-local artifacts only; no Homey/network/device calls.
OnCalendar=*-*-* *:*:40
Persistent=true
AccuracySec=5s
Unit=ems-flex-context-history.service

[Install]
WantedBy=timers.target
