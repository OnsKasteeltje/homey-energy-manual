[Unit]
Description=PARKED LEGACY - standalone EMS Weather Forecast

[Timer]
# PARKED LEGACY: production cadence is owned by ems-forecast-chain.timer.
# scripts/deploy_ems_pi.sh explicitly disables and stops this timer.
OnCalendar=*-*-* *:01,16,31,46:00
Persistent=true
Unit=ems-weather-forecast.service

[Install]
WantedBy=timers.target
