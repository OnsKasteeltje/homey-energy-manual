[Unit]
Description=EMS read-only AI analysis API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jeroen
WorkingDirectory=/home/jeroen/ems/runtime/analysis-api
Environment=EMS_AI_HOST=127.0.0.1
Environment=EMS_AI_PORT=3210
Environment=EMS_AI_MODEL=gpt-6-luna
EnvironmentFile=-/etc/ems/ai-agent.env
ExecStart=/usr/bin/python3 /home/jeroen/ems/runtime/analysis-api/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/jeroen/ems/data /home/jeroen/ems/runtime /usr/local/bin/ems-performance
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
